generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Game {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  players   Player[]
  rounds    Round[]
}

model Player {
  id     Int    @id @default(autoincrement())
  name   String
  game   Game   @relation(fields: [gameId], references: [id])
  gameId Int
}

model Round {
  id     Int    @id @default(autoincrement())
  game   Game   @relation(fields: [gameId], references: [id])
  gameId Int
  scores String
  number Int
}
